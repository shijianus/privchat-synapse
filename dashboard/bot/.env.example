# 环境配置
NODE_ENV=development
PORT=3002
HOST=0.0.0.0

# Matrix Bot 配置
MATRIX_BOT_USERNAME=@appeal_bot:example.com
MATRIX_BOT_PASSWORD=your_bot_password_here
# 若已有访问令牌，可直接配置而无需密码
# MATRIX_BOT_ACCESS_TOKEN=your_bot_access_token
MATRIX_BOT_HOMESERVER=https://matrix.example.com
MATRIX_BOT_DISPLAY_NAME=申诉助理
MATRIX_BOT_AVATAR_URL=https://example.com/bot-avatar.png
MATRIX_BOT_STORAGE_PATH=./data/matrix-bot.json

# Dashboard API 配置
DASHBOARD_API_BASE_URL=http://127.0.0.1:3001
BOT_API_SECRET=your_shared_bot_jwt_secret

# 数据库配置 (与主 API 共享)
DATABASE_URL=postgresql://username:password@localhost:5432/synapse
DATABASE_SSL=false

# Redis 配置 (与主 API 共享)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# 安全配置
JWT_SECRET=your_jwt_secret_here_minimum_32_characters
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# 业务配置
APPEAL_ROOM_PREFIX=appeal_
VERIFICATION_ROOM_PREFIX=verify_
BOT_ADMIN_ROOM_ID=!adminRoomId:example.com

# 缓存配置
CACHE_TTL_SECONDS=300

# 日志配置
LOG_LEVEL=info
LOG_FORMAT=json
