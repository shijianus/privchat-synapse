# Dashboard Backend (Node.js) - sample environment
# DASHBOARD INTEGRATION

# Runtime
NODE_ENV=production
PORT=3001
DASHBOARD_HOST=127.0.0.1
LOG_LEVEL=info

# CORS allowlist (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,https://dashboard.example.com

# JWT (change these in production)
JWT_SECRET=please-change-me
JWT_REFRESH_SECRET=please-change-me-too

# Bot shared secret (for /api/v1/bot routes)
BOT_API_SECRET=replace-with-strong-random

# Token lifetimes (seconds)
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# Cache
DASHBOARD_CACHE_TTL_SECONDS=300

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_USER_EVENTS_CHANNEL=dashboard.user.invalidate

# Postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=synapse
DB_USER=synapse
DB_PASSWORD=
DB_MAX_CONNECTIONS=20

# ----------------------------------------------
# Matrix Dashboard Bot (Fastify + Matrix SDK)
# ----------------------------------------------
BOT_PORT=3002
BOT_HOST=127.0.0.1

# Matrix credentials for the bot account
MATRIX_HOMESERVER_URL=http://127.0.0.1:8008
MATRIX_BOT_USER=@adminbot:example.com
MATRIX_BOT_PASSWORD=change-me

# Dashboard API location and shared secret for callbacks/webhooks
DASHBOARD_API_BASE_URL=http://127.0.0.1:3001
BOT_SHARED_SECRET=${BOT_API_SECRET}

# Optional integrations (mail/SMS/TOTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMS_PROVIDER_API_KEY=

