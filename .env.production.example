# Production Environment Variables (Matrix Dashboard System)

# ── Synapse core ─────────────────────────────────────────────
SYNAPSE_SERVER_NAME=matrix.localhost
SYNAPSE_REPORT_STATS=no
SYNAPSE_NO_TLS=1                      # TLS 在 Nginx/Cloudflare 终止
SYNAPSE_ENABLE_REGISTRATION=yes
SYNAPSE_ALLOW_GUEST=no
SYNAPSE_HTTP_PORT=8008
SYNAPSE_REGISTRATION_SHARED_SECRET=change-me-registration-secret
SYNAPSE_MACAROON_SECRET_KEY=change-me-macaroon-secret
SYNAPSE_EVENT_CACHE_SIZE=10K
SYNAPSE_DASHBOARD_CACHE_TTL_SECONDS=300

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=synapse
POSTGRES_USER=synapse
POSTGRES_PASSWORD=change_me_postgres
DATABASE_URL=postgresql://synapse:change_me_postgres@postgres:5432/synapse

# ── Redis ────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis
REDIS_URL=redis://:change_me_redis@redis:6379/0
REDIS_USER_EVENTS_CHANNEL=dashboard.user_events

# ── Dashboard backend ────────────────────────────────────────
JWT_SECRET=change_me_jwt_secret_please_use_32chars_minimum
JWT_REFRESH_SECRET=change_me_jwt_refresh_secret_please_use_32chars
BOT_API_SECRET=matrix-bot-secret
CORS_ORIGINS=https://dashboard.localhost,https://matrix.localhost,http://localhost:3000,http://localhost:3001
LOG_LEVEL=info
LOG_FORMAT=json

# ── Dashboard frontend ───────────────────────────────────────
VITE_API_URL=https://dashboard.localhost/api/v1
VITE_MATRIX_SERVER=https://matrix.localhost
VITE_APP_NAME=Matrix Dashboard
VITE_APP_VERSION=1.0.7

# ── Matrix bot ───────────────────────────────────────────────
MATRIX_BOT_USERNAME=@appeal_bot:matrix.localhost
MATRIX_BOT_PASSWORD=change_me_bot_password
MATRIX_BOT_HOMESERVER=https://matrix.localhost
MATRIX_BOT_DISPLAY_NAME=申诉助理
BOT_ADMIN_ROOM_ID=!adminRoomId:matrix.localhost

# ── Observability ────────────────────────────────────────────
GRAFANA_PASSWORD=change_me_grafana_password
