# Production Environment Variables
# Matrix Dashboard System v1.0.7

# Database Configuration
POSTGRES_PASSWORD=your_secure_postgres_password_here
DATABASE_URL=postgresql://dashboard:your_secure_postgres_password_here@postgres:5432/synapse

# Redis Configuration
REDIS_PASSWORD=your_secure_redis_password_here
REDIS_URL=redis://:your_secure_redis_password_here@redis:6379

# JWT Configuration
JWT_SECRET=your_jwt_secret_minimum_32_characters_long

# Synapse Configuration
SYNAPSE_SERVER_NAME=matrix.example.com
SYNAPSE_REPORT_STATS=no

# CORS Configuration
CORS_ORIGINS=https://dashboard.example.com,https://api.example.com

# Matrix Bot Configuration
MATRIX_BOT_USERNAME=@appeal_bot:matrix.example.com
MATRIX_BOT_PASSWORD=your_secure_matrix_bot_password
MATRIX_BOT_HOMESERVER=https://matrix.example.com
MATRIX_BOT_DISPLAY_NAME=申诉助理
MATRIX_BOT_AVATAR_URL=https://example.com/bot-avatar.png
BOT_ADMIN_ROOM_ID=!adminRoomId:matrix.example.com

# Frontend Configuration
VITE_API_BASE_URL=https://api.example.com
VITE_MATRIX_SERVER=https://matrix.example.com
VITE_APP_NAME=Matrix Dashboard
VITE_APP_VERSION=1.0.7

# Monitoring Configuration
GRAFANA_PASSWORD=your_secure_grafana_password

# Security Configuration
POSTGRES_SSL=true
REDIS_SSL=false

# Performance Configuration
CACHE_TTL_SECONDS=300

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json

# Backup Configuration
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM

# Email Configuration (for notifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=Matrix Dashboard <noreply@example.com>

# SSL/TLS Configuration
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# Rate Limiting
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX_REQUESTS=100
BOT_RATE_LIMIT_WINDOW_MS=60000
BOT_RATE_LIMIT_MAX_REQUESTS=10

# File Upload Configuration
MAX_FILE_SIZE_MB=50
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# Media Storage Configuration
MEDIA_RETENTION_DAYS=90
STORAGE_CLEANUP_INTERVAL_HOURS=24

# Two-Factor Authentication
TWO_FACTOR_ISSUER=Matrix Dashboard
TWO_FACTOR_DIGITS=6
TWO_FACTOR_WINDOW=1

# Audit Log Configuration
AUDIT_LOG_RETENTION_DAYS=365
AUDIT_LOG_COMPRESSION=true

# Health Check Configuration
HEALTH_CHECK_INTERVAL_SECONDS=30
HEALTH_CHECK_TIMEOUT_SECONDS=10
HEALTH_CHECK_RETRIES=3